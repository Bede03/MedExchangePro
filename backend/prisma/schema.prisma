// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  fullName      String   @map("full_name")
  email         String   @unique
  password      String
  role          UserRole
  hospitalId    String   @map("hospital_id")
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  isActive      Boolean  @map("is_active")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  auditLogs     AuditLog[]

  @@map("users")
}

enum UserRole {
  admin
  clinician
  registrar
  hospital_staff

  @@map("user_role")
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  users                  User[]
  patients               Patient[]
  departments            HospitalDepartment[]
  
  referralsRequesting    Referral[] @relation("requestingHospital")
  referralsReceiving     Referral[] @relation("receivingHospital")
  sharedPatientRecords   SharedPatientRecord[]
  
  transfersFrom          Transfer[] @relation("transferFrom")
  transfersTo            Transfer[] @relation("transferTo")

  @@map("hospitals")
}

model HospitalDepartment {
  id        String   @id @default(cuid())
  hospitalId String  @map("hospital_id")
  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  departmentName  String  @map("department_name")
  category        String  // e.g., "Surgery", "Cardiology", "Internal Medicine"
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@unique([hospitalId, departmentName])
  @@map("hospital_departments")
}

model Patient {
  id            String   @id @default(cuid())
  name          String
  gender        Gender
  dob           String   // ISO date
  phone         String
  address       String
  nationalId    String   @unique @map("national_id")
  hospitalId    String   @map("hospital_id")
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  referrals              Referral[]
  sharedRecords          SharedPatientRecord[]

  @@map("patients")
}

enum Gender {
  male
  female
  other

  @@map("gender")
}

model Referral {
  id                      String                @id @default(cuid())
  referralNumber          Int                   @unique @map("referral_number")
  patientId               String                @map("patient_id")
  patient                 Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  reason                  String
  status                  ReferralStatus        @default(pending)
  priority                ReferralPriority
  department              String                @map("department") // Required department
  
  requestingHospitalId    String                @map("requesting_hospital_id")
  requestingHospital      Hospital              @relation("requestingHospital", fields: [requestingHospitalId], references: [id], onDelete: Restrict)
  
  receivingHospitalId     String                @map("receiving_hospital_id")
  receivingHospital       Hospital              @relation("receivingHospital", fields: [receivingHospitalId], references: [id], onDelete: Restrict)
  
  sharedPatientRecords    SharedPatientRecord[]
  
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  completedAt             DateTime?             @map("completed_at")

  @@map("referrals")
}

enum ReferralStatus {
  pending
  approved
  completed
  rejected

  @@map("referral_status")
}

enum ReferralPriority {
  Emergency
  Urgent
  Routine

  @@map("referral_priority")
}

model AuditLog {
  id            String           @id @default(cuid())
  action        AuditAction
  entityType    AuditEntityType  @map("entity_type")
  entityId      String           @map("entity_id")
  
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  ipAddress     String?          @map("ip_address")
  userAgent     String?          @map("user_agent")
  details       Json?
  status        String           @default("success")
  
  timestamp     DateTime         @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([entityId])
  @@index([timestamp])
}

enum AuditAction {
  User_Updated
  Status_Changed
  User_Created
  Data_Accessed
  Referral_Created
  Referral_Approved
  Referral_Rejected
  Patient_Created
  Patient_Updated
  Login
  Logout

  @@map("audit_action")
}

enum AuditEntityType {
  User
  Referral
  Patient
  Transfer
  Hospital

  @@map("audit_entity_type")
}

model SharedPatientRecord {
  id                    String   @id @default(cuid())
  referralId            String   @map("referral_id")
  referral              Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  
  patientId             String   @map("patient_id")
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  receivingHospitalId   String   @map("receiving_hospital_id")
  receivingHospital     Hospital @relation(fields: [receivingHospitalId], references: [id], onDelete: Cascade)
  
  // Medical records
  testResults           String?  @map("test_results")
  medications           String?  @map("medications")
  allergies             String?  @map("allergies")
  medicalHistory        String?  @map("medical_history")
  vitalsLastRecorded    String?  @map("vitals_last_recorded")
  currentDiagnosis      String?  @map("current_diagnosis")
  clinicalNotes         String?  @map("clinical_notes")
  patientDocuments      String?  @map("patient_documents")
  
  sharedAt              DateTime @default(now()) @map("shared_at")
  accessedAt            DateTime @updatedAt @map("accessed_at")
  expiresAt             DateTime @map("expires_at") // Auto-expire after 30 days
  
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("shared_patient_records")
  @@index([referralId])
  @@index([patientId])
  @@index([receivingHospitalId])
}

model Transfer {
  id                    String          @id @default(cuid())
  transferNumber        Int             @unique @default(autoincrement()) @map("transfer_number")
  transferId            String          @unique @map("transfer_id")
  
  // Patient identifier from external database (national ID)
  patientNationalId     String          @map("patient_national_id")
  patientName           String?         @map("patient_name") // Cache the name for display
  
  fromHospitalId        String          @map("from_hospital_id")
  fromHospital          Hospital        @relation("transferFrom", fields: [fromHospitalId], references: [id], onDelete: Restrict)
  
  toHospitalId          String          @map("to_hospital_id")
  toHospital            Hospital        @relation("transferTo", fields: [toHospitalId], references: [id], onDelete: Restrict)
  
  transferType          String          @map("transfer_type") // Emergency, Non-Emergency, Follow-up
  status                String          @default("pending") // pending, approved, in-transit, completed, rejected
  
  // Clinical details
  reasonForTransfer     String?         @map("reason_for_transfer")
  significantFindings   String?         @map("significant_findings")
  clinicalPresentation  String?         @map("clinical_presentation")
  immediateCondition    String?         @map("immediate_condition")
  
  // Vital signs
  temperature           String?
  spo2                  String?
  rr                    String?
  pulse                 String?
  bp                    String?
  weight                String?
  muac                  String?
  
  // Medical information
  laboratory            String?
  diagnosis             String?
  procedures            String?
  medications           String?
  
  // Transport details
  transportType         String?         @map("transport_type") // Ambulance, Other, None
  transportNotes        String?         @map("transport_notes")
  
  // Insurance
  insuranceType         String?         @map("insurance_type") // CBHI, RSSB, MMI, Other
  insuranceOther        String?         @map("insurance_other")
  
  // Contact information
  referringClinician    String?         @map("referring_clinician")
  referringPhone        String?         @map("referring_phone")
  receivingService      String?         @map("receiving_service")
  receivingPhone        String?         @map("receiving_phone")
  
  // Dates
  admissionDate         String?         @map("admission_date")
  admissionTime         String?         @map("admission_time")
  decisionDate          String?         @map("decision_date")
  decisionTime          String?         @map("decision_time")
  
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  externalPatientData   Json?           @map("external_patient_data")

  @@map("transfers")
  @@index([patientNationalId])
  @@index([fromHospitalId])
  @@index([toHospitalId])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  userId    String?
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

enum NotificationType {
  info
  success
  warning
  error

  @@map("notification_type")
}
